# SteamOgames reads its settings from environment variables. It does not load
# this file by itself: copy it to .env and start the app with
#     uv run --env-file .env python app.py
# or set the variables in your shell.
#
# No Steam API key is required: every endpoint used is keyless.

# Port the dashboard listens on (default: 5000)
# PORT=5000

# Set to 0 to serve the dashboard without scraping, for example when
# `python scraper.py` runs as a separate process (default: 1)
# SCRAPER_ENABLED=1

# Delete samples older than this many days, once a day (minimum: 30).
# Leave unset to keep the whole history, which is the default.
# HISTORY_DAYS=90
